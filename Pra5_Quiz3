package com.kh.ex1;
import java.util.Scanner;

public class Quiz3 {

	public static void main(String[] args) {
		//methodMine();
		methodTeacher();
	}
		
	
	public static void methodMine() {
		Scanner sc = new Scanner(System.in);

		System.out.print("첫 번째 수 : ");
		int n1 = sc.nextInt();
		System.out.print("두 번째 수 : ");
		int n2 = sc.nextInt();
		
		if (n1 < 1 || n2 < 1) {
			System.out.print("자연수를 입력해주세요.");
		}
		else { 	
			if (n1 <= n2) {
				for (int i = n1; i <= n2; i++) {
					System.out.printf("%d ", i);
				}
			}
			else {
				for (int i = n2; i <= n1; i++) {
					System.out.printf("%d ", i);
				}
			}
		}
		sc.close();
		
	}
	
	public static void methodTeacher() {
		Scanner sc = new Scanner(System.in);

		System.out.print("첫 번째 수 : ");
		int n1 = sc.nextInt();
		System.out.print("두 번째 수 : ");
		int n2 = sc.nextInt();
		
		int max = (n1 <= n2)? n2 : n1;
		int min = (n1 > n2)? n2 : n1;
		
		if (n1 < 1 || n2 < 1) {
			System.out.print("자연수를 입력해주세요.");
		}
		else { 	
			for (int i = min; i <= max; i++) {
					System.out.printf("%d ", i);
			}
		}
		sc.close();
		
	}

}
