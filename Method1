package com.kh.method;

public class Method1 {
	public static void main(String[] args) {
		/*
		 * 메소드: 함수. 클래스 내에서 특정 기능을 묶어 놓은 부분(블록).
		 * 
		 * 표현법
		 * [접근제한자] [예약어] 반환형 메소드명( [매개변수] ) {
		 * 		// 실행할 내용
		 * }
		 * (매개변수 : 메소드가 실행될 때 전달받을 값을 저장, 보관할 때 저장할 변수)
		 */
		hE();
		// 전달할 값이 없으니 빈 손()으로 호출하면 됨.
		// 이름(빈손);
		hE("이고은");
		hE("과장");
		//int x = getRandom();
		// 결과값을 새로 변수에 저장 가능.
		// 대입만 한 상태이므로 출력 명령은 따로!
		//System.out.println(x);
		System.out.println(getRandom());
		int y = getRandom(1024);
		System.out.println(y);
	}
	
	/**
	 * 메소드 실행 시 "Hi. Everyone!"을 콘솔창에 출력
	 * main 메소드에서 호출할 예정.
	 */
	public static void hE() { // hE 메소드 정의
		// main이 static에 올라가 있는데 메소드가 안 올라가 있으면 호출해서 쓸 수 없으니 static
		// 전달받은 값을 출력하는 '행위'이므로 결과'값'은 없음. 고로 void
		// 고정된 문자열을 출력할 예정이므로 따로 전달 안 받아도 됨. 매개변수 없음!
		// 상수함수의 일반식에 변수 없는 것처럼 생각하면 될 듯...
		System.out.println("Hi. Everyone!");
	}
	
	/**
	 * 메소드 실행 시 이름(name)을 전달받아 "안녕하세요 name님!"을 콘솔창에 출력
	 */
	
	public static void hE(String name) {
		System.out.printf("안녕하세요 %s님!\n", name);
	}
	
	/**
	 * 메소드 실행 시 1 이상 100 이하의 정수인 랜덤값을 추출하여 결과값으로 전달.
	 * 전달값(매개변수)이 없어서 hE()를 또 쓸 수는 없음...ㅠㅠ
	 */
	public static int getRandom() {
		// 메소드 이름을 지을 때는 호출하는 시점을 기준으로!
		// 호출하는 시점에 갖고 오기 : get어쩌구
		// 호출하는 시점에 저장 : set어쩌구
		// 대충 이런 느낌.
		return (int)(Math.random() * 100 + 1);
		
		// 메소드 실행 후 결과값을 돌려줄 때(전달할 때)
		// return 결과값;
	}
	
	/**
	 * 메소드 실행 시 1 이상 전달 받은 값(end) 이하의 정수인 랜덤값을 추출하여 결과값으로 전달.
	 */
	public static int getRandom(int a) {
		return (int)(Math.random() * a + 1);
	}
	
}
