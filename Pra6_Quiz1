package com.kh.ex1;
import java.util.Scanner;

public class Quiz1 {

	public static void main(String[] args) {
		int[] score = new int[5];
		Scanner sc = new Scanner(System.in);
		for (int i = 0; i < score.length; i++) {
			System.out.printf("%d번 학생 점수 입력 : ", i + 1);
			score[i] = sc.nextInt();
		}	
		
		int sum = 0;
		
		for (int s = 0; s < score.length; s++) {
			sum += score[s];
		}
		double mean = sum / score.length;
		
		System.out.println();
		System.out.println("총합 : " + sum + "점");
		System.out.println("평균 : " + mean + "점");
		
		sc.close();
	}

}
