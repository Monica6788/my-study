package com.kh.ex1;
import java.util.Scanner;

public class Quiz4 {

	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		for (int i = 1; i < n + 1; i++) {
			for (int j = 1; j < i + 1; j++) {
				System.out.print("*");
			}
			System.out.println();
		}
		
		
		sc.close();
	}

}
// 직각이등변삼각형이라 최종 값 자체는 둘 다 n이지만 i = 높이, j = 밑변
