package com.kh;

import java.util.Scanner;

public class A_For_1 {

	public static void main(String[] args) {
		gugudan();
		//oddsum();
		//evensum();

	}
	
	public static void gugudan() {
		for (int i = 2; i < 10; i++) {
			for (int j = 1; j < 10; j++) {
				if (j == 1) {
					System.out.println("---" + i + "단---");
					}
				System.out.printf("%d * %d = %d\n", i, j, i * j);
			}
		}
	}
	
	public static void oddsum() {
		Scanner sc = new Scanner(System.in);
		int sum = 0;
		int n = sc.nextInt();
		for (int i = 1; i <= n; i += 2) {
			sum += i;
		}
		System.out.printf("%d 이하인 홀수의 합은 %d입니다.", n, sum);
		sc.close();
	}

	public static void evensum() {
		Scanner sc = new Scanner(System.in);
		int sum = 0;
		int n = sc.nextInt();
		for (int i = 2; i <= n; i += 2) {
			sum += i;
		}
		System.out.printf("%d 이하인 짝수의 합은 %d입니다.", n, sum);
		sc.close();
	}
}
