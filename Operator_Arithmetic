package com.kh;

public class A_Arithmetic {
	/*
	 * 산술 연산자 (이항 연산자) => + - * / %
	 *  우선 순위 : * / % => + -
	 */
	public static void main(String[] args) {
		//method1();
		method2();
	}
	
	public static void method1() {
		// 10, 3 값을 각각 n1, n2 변수에 저장
		int n1 = 10;
		int n2 = 3;
		
		// n1, n2의 합, 차 곱, 몫, 나머지 출력
		
		System.out.println("n1+n2 = " + (n1 + n2));
		// 문자열 + n1 + n2로 적으면 103으로 나옴.
		// 우선순위를 알 수 있도록 () 추가!
		System.out.println("n1-n2 = " + (n1 - n2));
		// n1-n2에 소괄호를 씌우지 않으면 문자열 + n1 -n2 순서대로 수행
		// 문자열과 정수(n2)끼리 - 연산을 할 수 없다고 오류 남.
		System.out.println("n1*n2 = " + (n1 * n2));
		System.out.printf("n1÷n2 = %d ... %d\n", (n1 / n2), (n1 % n2));
		
	}
	
	public static void method2() {
		int a = 5;
		int b = 10;
		int c = ++a + b; // a = 6, c = 16
		int d = c / a; // 16 / 6 = 2 = d
		int e = c % a; // 16 % 6 = 4 = e
		int f = e++; // f = 4, e = 5
		int g = --b + d--; // b = 9, 9 + 2 = 11 = g, d =1
		int h =2;
		int i = a++ + b /(--c / f) * (g-- - d) % (++e + h);
		// 6 + 9 / ( 15 / 4 ) * ( 11 - 1 ) % ( 6 + 2 )
		// a = 7, c = 15, g = 10, e = 6
		// 6 + 9 / (3) * (10) % (8)
		// = 6 + 3 * 10 % 8 = 6 + 30 % 8 = 6 + 6 = 12 = i
		// a= 7, b = 9, c = 15, d = 1, e =6, f = 4, g = 10, h = 2, i =12
		
		System.out.println("a = "+ a);
		System.out.println("b = "+ b);
		System.out.println("c = "+ c);
		System.out.println("d = "+ d);
		System.out.println("e = "+ e);
		System.out.println("f = "+ f);
		System.out.println("g = "+ g);
		System.out.println("h = "+ h);
		System.out.println("i = "+ i);
	}

}
